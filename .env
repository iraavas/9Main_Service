# --- Ограничения ресурсов ---
APP_MEM_LIMIT=1012m
APP_CPU_LIMIT=0.5

# --- Параметры БД ---
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=module1
DB_PORT=5432
DB_HOST=database

# --- Основной сервис ---
MAIN_SERVICE_PORT=8081

# --- Additional сервис ---
ADDITIONAL_SERVICE_PORT=8082
MAIN_SERVICE_HOST=spring-boot-app

# --- Tomcat и Hibernate ---
TOMCAT_THREADS=100
SHOW_SQL=false



